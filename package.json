{
  "name": "i18n-jump",
  "displayName": "i18n Jump",
  "description": "悬停查看翻译、Cmd+点击跳到词条、中文内联提示；Vue/React/TS 通用，语言与词条位置可配置",
  "version": "0.1.6",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:vue",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "i18nJump.toggleInline",
        "title": "切换翻译内联提示",
        "category": "i18n"
      }
    ],
    "configuration": {
      "title": "i18n Jump",
      "properties": {
        "i18nJump.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "zh-CN",
            "en-US"
          ],
          "markdownDescription": "语言目录名。**第一个**是默认语言：Cmd+点击与内联提示都用它。"
        },
        "i18nJump.localePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "apps/web/src/locales/{lang}",
            "packages/shared/src/i18n/{lang}",
            "packages/shared/src/i18n/{lang}/modules",
            "apps/server/src/i18n/{lang}"
          ],
          "markdownDescription": "词条文件所在目录，相对工作区根目录；`{lang}` 会替换成上面的语言名。扩展会读每个目录下的 `*.json`。"
        },
        "i18nJump.inlineMaxLength": {
          "type": "number",
          "minimum": 1,
          "default": 15,
          "markdownDescription": "内联提示保留的字符数，超出用 `…` 截断。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/francyfrees/vscode-i18n-jump.git"
  },
  "license": "MIT"
}
